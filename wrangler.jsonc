{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker that owns the custom domain. Renaming this deploys a
  // brand-new Worker and leaves the live one untouched.
  "name": "meals",
  "account_id": "be6bb19e0b5ad8f05e426a5a8c339ba0",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  },
  // Attaches the Worker to the custom hostname on deploy. Cloudflare creates
  // the proxied DNS record and certificate automatically. The hostname must
  // have no other DNS record or Worker route before the first deploy.
  "routes": [
    {
      "pattern": "meals.amirfamily.org",
      "zone_name": "amirfamily.org",
      "custom_domain": true
    }
  ],
  "vars": {
    "DEMO_MODE": "false",
    // Public client id of the GitHub OAuth app (not a secret). Keeping it here
    // means `wrangler deploy` never drops it; GITHUB_CLIENT_SECRET stays a secret.
    "GITHUB_CLIENT_ID": "Ov23liPIhWyDD36o6jA7"
  }
}
