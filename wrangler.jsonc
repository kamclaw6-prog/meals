{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mise",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  },
  // Attaches the Worker to the custom hostname on deploy. Cloudflare creates
  // the proxied DNS record and certificate automatically. The hostname must
  // have no other DNS record or Worker route before the first deploy.
  "routes": [
    {
      "pattern": "meals.amirfamily.org",
      "zone_name": "amirfamily.org",
      "custom_domain": true
    }
  ],
  "vars": {
    "DEMO_MODE": "false"
  }
}
