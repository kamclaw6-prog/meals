{
  "name": "mise",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mise — a calm meal planner with recipes and grocery lists, stored in your own GitHub repository.",
  "scripts": {
    "dev": "concurrently -k -n web,worker -c magenta,cyan \"vite\" \"wrangler dev\"",
    "dev:web": "vite",
    "dev:worker": "wrangler dev",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && vite build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "hono": "^4.13.14",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261027.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.153.0"
  }
}
